generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Required for Credentials auth
  accounts      Account[]
  sessions      Session[]

  createdAt        DateTime @default(now())
  isPro            Boolean  @default(false)
  credits          Int      @default(3) // Free tier: 3 credits
  
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  resumes Resume[]
  skillGaps           UserSkillGap[]
  skillGapOccurrences SkillGapOccurrence[]
  learningProgress    LearningProgress[]
  profileSkills       UserSkill[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String // e.g. "Software Engineer - Google"
  originalText    String? // Extracted text from uploaded PDF
  originalFileUrl String?

  targetJobDesc String? // The JD text

  // Analysis Results
  atsScore      Int      @default(0)
  keywordMatch  Int      @default(0)
  missingSkills String[] // JSON array or simple string list in Prisma (Postgres supports String[])
  improvements  Json?    // Stores { bulletPointsRewritten: number, keywordsAdded: [], ... }

  // Structured Content (The "Source of Truth" for the editor)
  structuredData Json? // { summary, skills, experience: [], projects: [], education: [] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillGapOccurrences SkillGapOccurrence[]
}

model UserSkillGap {
  id              String    @id @default(cuid())
  userId          String
  canonicalSkill  String
  missingCount    Int       @default(1)
  firstDetectedAt DateTime  @default(now())
  lastDetectedAt  DateTime  @default(now())
  sourceCount     Int       @default(1)
  status          String    @default("learning") // "learning" | "acquired"
  acquiredAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalSkill])
  @@index([userId, missingCount(sort: Desc)])
  @@index([userId, status])
}

model SkillGapOccurrence {
  id             String   @id @default(cuid())
  userId         String
  canonicalSkill String
  originalSkill  String?
  resumeId       String?
  jobTitle       String?
  targetJobDesc  String?  @db.Text
  detectedAt     DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([userId, canonicalSkill, resumeId])
  @@index([userId, canonicalSkill])
  @@index([userId, detectedAt(sort: Desc)])
}

model LearningProgress {
  id             String   @id @default(cuid())
  userId         String
  canonicalSkill String
  stepId         String
  status         String   @default("not_started") // "not_started" | "in_progress" | "completed"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalSkill, stepId])
  @@index([userId, canonicalSkill])
}

model UserSkill {
  id             String   @id @default(cuid())
  userId         String
  canonicalSkill String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalSkill])
}
