generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Required for Credentials auth
  accounts      Account[]
  sessions      Session[]

  createdAt        DateTime @default(now())
  isPro            Boolean  @default(false)
  credits          Int      @default(3) // Free tier: 3 credits
  
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  resumes Resume[]
  skillGaps           UserSkillGap[]
  skillGapOccurrences SkillGapOccurrence[]
  learningProgress    LearningProgress[]
  profileSkills       UserSkill[]
  skillLevels         UserSkillLevel[]
  assessments         SkillAssessment[]

  // Connected Profile URLs and safe profile data
  githubUrl           String?
  linkedinUrl         String?
  linkedinData        Json? // Safe pasted/imported profile info: { headline, about, experience, skills, etc. }
  profileScores       ProfileScore[]
  profileChecks       ProfileScoreCheck[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String // e.g. "Software Engineer - Google"
  originalText    String? // Extracted text from uploaded PDF
  originalFileUrl String?

  targetJobDesc String? // The JD text

  // Analysis Results
  atsScore      Int      @default(0)
  keywordMatch  Int      @default(0)
  missingSkills String[] // JSON array or simple string list in Prisma (Postgres supports String[])
  improvements  Json?    // Stores { bulletPointsRewritten: number, keywordsAdded: [], ... }

  // Structured Content (The "Source of Truth" for the editor)
  structuredData Json? // { summary, skills, experience: [], projects: [], education: [] }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skillGapOccurrences SkillGapOccurrence[]
  profileScores       ProfileScore[]
}

model ProfileScore {
  id           String   @id @default(cuid())
  userId       String
  resumeId     String?
  jobId        String?
  platform     String   // "github" | "linkedin" | "overall"
  score        Int      // 0 - 100
  targetRole   String?
  breakdown    Json     // Detailed category scores
  evidence     Json?    // Matched skills, repository/experience evidence
  strengths    String[] // "Why" points
  improvements String[] // "Needs improvement" points
  assessedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId, resumeId, platform])
  @@index([userId, assessedAt(sort: Desc)])
}

model ProfileScoreCheck {
  id              String   @id @default(cuid())
  userId          String
  role            String
  company         String?
  inputType       String   // "jd" | "role"
  jdSnippet       String?  @db.Text
  githubScore     Int?
  linkedinScore   Int?
  overallScore    Int
  breakdown       Json     // { github, linkedin, overall }
  skillMatches    Json     // Array of SkillMatrixRow
  strengths       String[]
  weaknesses      String[]
  recommendations Json     // Array of ActionableRecommendation
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model UserSkillGap {
  id              String    @id @default(cuid())
  userId          String
  canonicalSkill  String
  missingCount    Int       @default(1)
  firstDetectedAt DateTime  @default(now())
  lastDetectedAt  DateTime  @default(now())
  sourceCount     Int       @default(1)
  status          String    @default("learning") // "learning" | "acquired"
  acquiredAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalSkill])
  @@index([userId, missingCount(sort: Desc)])
  @@index([userId, status])
}

model SkillGapOccurrence {
  id             String   @id @default(cuid())
  userId         String
  canonicalSkill String
  originalSkill  String?
  resumeId       String?
  jobTitle       String?
  targetJobDesc  String?  @db.Text
  detectedAt     DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@unique([userId, canonicalSkill, resumeId])
  @@index([userId, canonicalSkill])
  @@index([userId, detectedAt(sort: Desc)])
}

model LearningProgress {
  id             String   @id @default(cuid())
  userId         String
  canonicalSkill String
  stepId         String
  status         String   @default("not_started") // "not_started" | "in_progress" | "completed"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalSkill, stepId])
  @@index([userId, canonicalSkill])
}

model UserSkill {
  id             String   @id @default(cuid())
  userId         String
  canonicalSkill String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalSkill])
}

model SkillCurriculum {
  id              String   @id @default(cuid())
  skillId         String   // canonical skill name, e.g. "PostgreSQL", "Docker"
  version         Int      @default(1)
  description     String   @db.Text
  targetRoles     String[] // e.g. ["Backend Developer", "DevOps Engineer"]
  prerequisites   String[]
  estimatedHours  Int      @default(20)
  isAiGenerated   Boolean  @default(false)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modules         LearningModule[]
  implementations LearningImplementation[]

  @@unique([skillId, version])
  @@index([skillId])
}

model LearningModule {
  id             String          @id @default(cuid())
  curriculumId   String
  curriculum     SkillCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  title          String
  description    String          @db.Text
  level          String          // "beginner" | "intermediate" | "advanced"
  order          Int
  estimatedHours Int             @default(5)
  topics         LearningTopic[]

  @@index([curriculumId])
}

model LearningTopic {
  id               String          @id @default(cuid())
  moduleId         String
  module           LearningModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  description      String          @db.Text
  order            Int
  required         Boolean         @default(true)
  estimatedMinutes Int             @default(60)

  resources        CuratedResource[]
  practiceTasks    LearningPractice[]
  prerequisites    LearningTopicPrerequisite[] @relation("TopicDependencies")
  dependentOnMe    LearningTopicPrerequisite[] @relation("TopicPrerequisites")

  @@index([moduleId])
}

model LearningTopicPrerequisite {
  id                  String        @id @default(cuid())
  topicId             String
  prerequisiteTopicId String

  topic               LearningTopic @relation("TopicDependencies", fields: [topicId], references: [id], onDelete: Cascade)
  prerequisite        LearningTopic @relation("TopicPrerequisites", fields: [prerequisiteTopicId], references: [id], onDelete: Cascade)

  @@unique([topicId, prerequisiteTopicId])
}

model CuratedResource {
  id                String         @id @default(cuid())
  skillId           String
  topicId           String?
  topic             LearningTopic? @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title             String
  url               String         @db.Text
  provider          String
  resourceType      String         // "official_docs" | "structured_course" | "tutorial" | "interactive" | "practice" | "project" | "video" | "book" | "documentation"
  level             String         @default("all") // "beginner" | "intermediate" | "advanced" | "all"
  isFree            Boolean        @default(true)
  isOfficial        Boolean        @default(false)
  qualityScore      Float          @default(85.0)
  interactive       Boolean        @default(false)
  projectBased      Boolean        @default(false)
  estimatedMinutes  Int            @default(30)
  lastVerifiedAt    DateTime?
  status            String         @default("active") // "active" | "inactive" | "redirected" | "unknown"
  verificationError String?
  isPrimary         Boolean        @default(false)
  whyThisResource   String?        @db.Text
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([skillId])
  @@index([topicId])
  @@index([isFree, status])
}

model LearningPractice {
  id                 String        @id @default(cuid())
  topicId            String
  topic              LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  title              String
  description        String        @db.Text
  difficulty         String        @default("intermediate") // "beginner" | "intermediate" | "advanced"
  expectedOutcome    String        @db.Text
  verificationMethod String        @default("quiz") // "code_execution" | "explain_analyze" | "quiz" | "manual_check"
  order              Int           @default(1)
  hints              String[]      @default([])

  @@index([topicId])
}

model LearningImplementation {
  id                   String          @id @default(cuid())
  curriculumId         String
  curriculum           SkillCurriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  skillId              String
  title                String
  description          String          @db.Text
  requirements         String[]        // concrete measurable deliverables
  expectedTechnologies String[]
  difficulty           String          @default("intermediate") // "intermediate" | "advanced"
  estimatedHours       Int             @default(10)
  order                Int             @default(1)
  isCapstone           Boolean         @default(false)

  @@index([curriculumId])
  @@index([skillId])
}

model UserSkillLevel {
  id         String   @id @default(cuid())
  userId     String
  skillId    String   // canonical skill
  level      String   @default("beginner") // "beginner" | "elementary" | "intermediate" | "advanced"
  confidence Float    @default(0.8)
  evidence   Json?    // e.g. { matchedSkills: [], resumeEvidence: [], priorProgress: 0 }
  assessedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
}

model SkillAssessment {
  id             String   @id @default(cuid())
  userId         String
  skillId        String   // canonical skill
  score          Float    // 0 - 100
  level          String   // "beginner" | "intermediate" | "advanced"
  assessmentType String   // "checkpoint" | "mcq" | "practical" | "capstone"
  evidence       Json?    // questions, answers, githubUrl, etc.
  assessedAt     DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skillId])
}

model LearningRequirement {
  id             String   @id @default(cuid())
  skillId        String
  topicId        String?
  relevanceScore Float    @default(1.0)
  jdId           String?
  reason         String   @db.Text
  createdAt      DateTime @default(now())

  @@index([skillId, jdId])
}

